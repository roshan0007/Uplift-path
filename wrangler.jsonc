{
  // Static assets plus one server route. `out/` is served straight from
  // Cloudflare's edge; `worker/index.ts` runs only for the paths listed in
  // `run_worker_first`, so every other request never touches the script.
  // `npx wrangler deploy` reads this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uplift-path",
  "compatibility_date": "2026-08-24",
  // POST /api/coach-response — the coach accept/decline route. It holds the
  // Zoho API key (secret `ZOHO_COACH_API_URL`, set with `wrangler secret put`,
  // never in this file). See worker/index.ts.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    // Lets the Worker hand any non-API request on to the static files.
    "binding": "ASSETS",
    // Only the API runs the Worker first; the rest of the site is untouched.
    "run_worker_first": ["/api/*"],
    // `out/about.html` is served at `/about`, matching Next's static export.
    "html_handling": "auto-trailing-slash",
    // Multi-page site, not an SPA — serve Next's generated 404.html.
    "not_found_handling": "404-page"
  },
  // A brake on the coach route: 20 requests a minute per caller and per case
  // (per Cloudflare location). The Worker keys it twice; see worker/index.ts.
  "ratelimits": [
    {
      "name": "COACH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
