{
  // Static-assets-only Worker: there is no `main` script, so Cloudflare just
  // serves the files in `out/`. `npx wrangler deploy` reads this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uplift-path",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./out",
    // `out/about.html` is served at `/about`, matching Next's static export.
    "html_handling": "auto-trailing-slash",
    // Multi-page site, not an SPA — serve Next's generated 404.html.
    "not_found_handling": "404-page"
  }
}
